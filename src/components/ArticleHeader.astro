---
import PageHeader from "./PageHeader.astro";
import TagRow from "./TagRow.astro";
import TechLine from "./TechLine.astro";

type Props = {
    title: string;
    backHref: string;
    metadata: string[];
    tags?: string[];
    technologies?: string[];
};

const {
    title,
    backHref,
    metadata,
    tags = [],
    technologies = [],
} = Astro.props;
---

<PageHeader title={title} backHref={backHref}>
    <p
        class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-semibold italic text-muted"
    >
        {
            metadata.map((item, index) => (
                <>
                    {index > 0 && (
                        <span class="metadata-separator" aria-hidden="true">
                            •
                        </span>
                    )}
                    <span>{item}</span>
                </>
            ))
        }
    </p>

    <TagRow tags={tags} />

    <TechLine technologies={technologies} />

    <slot />
</PageHeader>
