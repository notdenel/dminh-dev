---
import PageHeader from "./PageHeader.astro";

type Props = {
    title: string;
    backHref: string;
    metadata: string[];
    pills?: string[];
    pillHref?: (pill: string) => string | undefined;
};

const { title, backHref, metadata, pills = [], pillHref } = Astro.props;
---

<PageHeader title={title} backHref={backHref}>
    <p
        class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-semibold italic text-muted"
    >
        {
            metadata.map((item, index) => (
                <>
                    {index > 0 && (
                        <span class="metadata-separator" aria-hidden="true">
                            •
                        </span>
                    )}
                    <span>{item}</span>
                </>
            ))
        }
    </p>

    {
        pills.length > 0 && (
            <div class="flex flex-wrap gap-2">
                {pills.map((pill) => {
                    const href = pillHref?.(pill);
                    return href ? (
                        <a href={href} class="tag-pill">
                            #{pill}
                        </a>
                    ) : (
                        <span class="tech-pill">{pill}</span>
                    );
                })}
            </div>
        )
    }

    <slot />
</PageHeader>
