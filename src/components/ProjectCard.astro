---
type Props = {
    title: string;
    description: string;
    tags?: string[]; // array makes it easy to pass the tags themselves -> can turn into pills later
    href?: string;
};

const { title, description, tags = [], href } = Astro.props;
---

<article class="rounded-lg border border-zinc-800 p-5 transition-colors hover:border-zinc-700">
    {
        href ? (
            <h3 class="font-medium text-zinc-100">
                <a href={href} class="hover:text-zinc-300">
                    {title}
                </a>
            </h3>
        ) : (
            <h3 class="font-medium text-zinc-100">{title}</h3>
        )
    }

    <p class="mt-2 leading-7 text-zinc-400">
        {description}
    </p>

    {
        tags.length > 0 && (
            <p class="mt-3 text-sm text-zinc-500">{tags.join(" · ")}</p>
        )
    }
</article>
