---
interface Props {
    title: string;
    description: string;
    technologies: string[];
    href: string;
    status: string;
}

const { title, description, technologies, href, status: projectStatus } = Astro.props;
---

<a
    href={href}
    class="project-card block rounded-lg"
>
    <article class="card-surface rounded-lg border p-5">

        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h3 class="project-card-title font-semibold text-ink">
                {title}
            </h3>

            <span
                class="flex items-baseline gap-x-3 text-sm font-semibold italic text-muted"
            >
                <span class="metadata-separator" aria-hidden="true">•</span>
                <span>{projectStatus}</span>
            </span>
        </div>

        <p class="font-copy mt-2 leading-7 text-muted">
            {description}
        </p>

        {
            technologies.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-2">
                    {technologies.map((technology) => (
                        <span class="tech-pill">{technology}</span>
                    ))}
                </div>
            )
        }
    </article>
</a>
