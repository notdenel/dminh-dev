<a
    href={href}
    class="project-card group block rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--site-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--site-bg)]"
>
    <article class="card-surface rounded-lg border p-5">
        <!-- <h3 class="project-card-title font-semibold text-zinc-100">
            {title}
        </h3>

        <span class="flex items-baseline gap-x-3 text-sm font-semibold italic text-zinc-500">
            <span class="metadata-separator" aria-hidden="true">•</span>
            <span>{status}</span>
        </span> -->

        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h3 class="project-card-title font-semibold text-zinc-100">
                {title}
            </h3>

            <span
                class="flex items-baseline gap-x-3 text-sm font-semibold italic text-zinc-500"
            >
                <span class="metadata-separator" aria-hidden="true">•</span>
                <span>{projectStatus}</span>
            </span>
        </div>

        <p class="font-copy mt-2 leading-7 text-zinc-400">
            {description}
        </p>

        {
            technologies.length > 0 && (
                <div class="mt-3 flex flex-wrap font-medium gap-2">
                    {technologies.map((technology) => (
                        <span class="tech-pill">{technology}</span>
                    ))}
                </div>
            )
        }
    </article>
</a>
