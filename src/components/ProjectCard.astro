---
type Props = {
    title: string;
    description: string;
    tags?: string[]; // array makes it easy to pass the tags themselves -> can turn into pills later
    href?: string;
};

const { title, description, tags = [], href } = Astro.props;
---

<article class="card-surface rounded-lg border p-5">
    {
        href ? (
            <h3 class="font-medium text-zinc-100">
                <a href={href} class="site-link-strong">
                    {title}
                </a>
            </h3>
        ) : (
            <h3 class="font-medium text-zinc-100">{title}</h3>
        )
    }

    <p class="font-copy mt-2 leading-7 text-zinc-400">
        {description}
    </p>

    {
        tags.length > 0 && (
            <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-semibold text-zinc-500">
                {tags.map((tag, index) => (
                    <>
                        {index > 0 && (
                            <span class="metadata-separator" aria-hidden="true">
                                •
                            </span>
                        )}
                        <span>{tag}</span>
                    </>
                ))}
            </p>
        )
    }
</article>
