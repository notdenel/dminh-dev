---
const normalizePath = (path: string) => {
  const normalized = path.replace(/\/$/, "");
  return normalized || "/";
};

const pathname = normalizePath(Astro.url.pathname); // get current page path, then normalize so that
                                                    // something like /blog and /blog/ are handled the same

const isActive = (href: string) => {
  const normalizedHref = normalizePath(href);

  if (normalizedHref === "/") {
    return pathname === "/";
  }

  // check whether the current page match nav link so a blog post will still activate nav item
  return (
    pathname === normalizedHref || pathname.startsWith(`${normalizedHref}/`)
  );
};

const navLinks = [
  { href: "/blog", label: "blog" },
  { href: "/projects", label: "projects" },
];
---

<!-- One row wherever it fits. The wrap is the fallback, not the mobile
     layout: title + nav measure 327px against 362 at 402px and 335 at 375px,
     so every current phone gets a single line and only a 360px-or-narrower
     screen drops the nav to its own row. flex-wrap does that on its own, so
     there is no breakpoint here to keep in sync with the type. -->
<header class="mb-16 flex flex-row flex-wrap items-center justify-between gap-x-4 gap-y-2 text-ui sm:gap-x-6">
  <a href="/" class="site-link-strong font-semibold tracking-tight">
    dminh.dev
  </a>

  <!-- Tighter between links on a phone: it buys the 12px that keeps the
       single row alive down to 360px. -->
  <nav class="font-semibold flex flex-wrap items-center gap-x-3 gap-y-2 sm:gap-x-4">
    {
      navLinks.map((link) => {
        const active = isActive(link.href);

        return (
          <a
            href={link.href}
            class={active ? "site-link site-link-active" : "site-link"}
            aria-current={active ? "page" : undefined} 
          > 
            {link.label}
          </a>
        );
      })
    }

    <a href="https://github.com/notdenel" class="site-link">github</a>
    <a href="https://www.linkedin.com/in/dminhsims/" class="site-link">
      linkedin
    </a>
  </nav>
</header>
