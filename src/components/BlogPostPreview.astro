---
type Props = {
    title: string;
    description: string;
    date: string;
    tags?: string[];
    href: string;
};

const { title, description, date, tags = [], href } = Astro.props;

const tagHref = (tag: string) => `/blog/tags/${encodeURIComponent(tag)}`;
---

<article>
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <h3 class="text-lg font-semibold leading-snug text-ink">
            <a href={href} class="site-link-strong">
                {title}
            </a>
        </h3>

        <span class="flex items-baseline gap-x-3 text-sm font-semibold italic text-muted">
            <span class="metadata-separator" aria-hidden="true">•</span>
            <span>{date}</span>
        </span>
    </div>

    <p class="font-copy mt-2 max-w-2xl leading-6 text-muted">
        {description}
    </p>

    {
        tags.length > 0 && (
            <div class="font-medium mt-3 flex flex-wrap gap-2">
                {tags.map((tag) => (
                    <a href={tagHref(tag)} class="tag-pill">
                        #{tag}
                    </a>
                ))}
            </div>
        )
    }
</article>
