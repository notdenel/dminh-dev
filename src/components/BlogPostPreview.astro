---
import TagRow from "./TagRow.astro";

type Props = {
    title: string;
    description: string;
    date: string;
    tags?: string[];
    href: string;
};

const { title, description, date, tags = [], href } = Astro.props;
---

<article>
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <h3 class="text-subhead font-semibold text-ink">
            <a href={href} class="site-link-strong">
                {title}
            </a>
        </h3>

        <span
            class="metadata-row flex items-baseline gap-x-3 text-ui italic tabular-nums text-muted"
        >
            <span class="metadata-separator" aria-hidden="true">•</span>
            <span>{date}</span>
        </span>
    </div>

    <p class="font-copy mt-2 max-w-2xl text-meta text-muted">
        {description}
    </p>

    <div class="mt-3">
        <TagRow tags={tags} />
    </div>
</article>
