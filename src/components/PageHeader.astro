---
import BackLink from "./BackLink.astro";

type Props = {
    title: string;
    lede?: string;
    backHref?: string;
};

const { title, lede, backHref } = Astro.props;
---

<section class="flex flex-col gap-6">
    {
        backHref && (
            <div class="mb-2">
                <BackLink href={backHref} />
            </div>
        )
    }

    <h1 class="text-display font-semibold tracking-tight text-balance text-ink">
        {title}
    </h1>

    {
        lede && (
            <p class="page-lede font-copy max-w-2xl text-body text-soft">
                {lede}
            </p>
        )
    }

    <slot />
</section>
