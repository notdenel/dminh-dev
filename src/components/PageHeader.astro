---
import BackLink from "./BackLink.astro";

type Props = {
    title: string;
    lede?: string;
    backHref?: string;
};

const { title, lede, backHref } = Astro.props;
---

<section class="space-y-6">
    {
        backHref && (
            <div class="mb-6">
                <BackLink href={backHref} />
            </div>
        )
    }

    <h1 class="text-4xl font-semibold tracking-tight text-zinc-50 sm:text-5xl">
        {title}
    </h1>

    {
        lede && (
            <p class="font-copy max-w-2xl text-lg leading-8 text-zinc-300">
                {lede}
            </p>
        )
    }

    <slot />
</section>
