---
type Props = {
  label?: string;
  href?: string;
  class?: string;
};

const {
  label = "← back",
  href = "/",
  class: className = "",
} = Astro.props;

const classes = [
  "back-button text-sm text-zinc-500 hover:text-zinc-300",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<a href={href} class={classes}>
  {label}
</a>