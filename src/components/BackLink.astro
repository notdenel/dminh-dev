---
type Props = {
  label?: string;
  href?: string;
  class?: string;
};

const {
  label = "← back",
  href = "/",
  class: className = "",
} = Astro.props;

const classes = ["back-button site-link text-sm", className]
  .filter(Boolean)
  .join(" ");
---

<a href={href} class={classes}>
  {label}
</a>