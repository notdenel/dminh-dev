---
import SocialIconLink from "./SocialIconLink.astro";

const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-zinc-800 pt-6 text-sm font-medium text-zinc-500">
  <div
    class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
  >
    <p>&copy; {currentYear} Daniel Sims</p>

    <div class="flex items-center gap-4">
      <SocialIconLink
        href="https://github.com/notdenel"
        label="GitHub"
        icon="github"
      />

      <SocialIconLink
        href="https://www.linkedin.com/in/dminhsims/"
        label="LinkedIn"
        icon="linkedin"
      />

      <SocialIconLink
        href="mailto:dminhsims@gmail.com"
        label="Email"
        icon="email"
      />
    </div>
  </div>
</footer>
