---
// What the browser hands over without being asked. Everything here is read
// from the client at render time and nothing is sent anywhere — no API, no
// key, no request. Permission-gated signals (location, camera, clipboard)
// and hostile ones (canvas hashing) are deliberately absent: the point is
// that the mundane stuff is already enough.
type Props = { voice: "deadpan" | "playful" };
const { voice } = Astro.props;

const copy = {
    deadpan: {
        caption: "what your browser reported",
        footer: "none of it was requested. none of it left this page.",
        labels: {
            timezone: "timezone",
            time: "local time",
            language: "language",
            screen: "screen",
            platform: "platform",
            engine: "browser",
            theme: "theme",
            pointer: "pointer",
            cores: "cores",
        },
    },
    playful: {
        caption: "things you told me without meaning to",
        footer: "i never asked for any of this, and it never left your browser.",
        labels: {
            timezone: "you're somewhere near",
            time: "where it is currently",
            language: "you read",
            screen: "on a screen about",
            platform: "running",
            engine: "through",
            theme: "with the lights",
            pointer: "and you're using",
            cores: "on a machine with",
        },
    },
}[voice];

const rows = Object.entries(copy.labels);
---

<figure class="fp" data-fp data-voice={voice} hidden>
    <figcaption class="fp-caption">{copy.caption}</figcaption>

    <dl class="fp-rows">
        {
            rows.map(([key, label]) => (
                <div class="fp-row" data-row={key}>
                    <dt class="fp-key">{label}</dt>
                    <dd class="fp-value" data-value={key}>
                        —
                    </dd>
                </div>
            ))
        }
    </dl>

    <p class="fp-footer">{copy.footer}</p>
</figure>

<script>
    // Ships hidden and only reveals once it has something to show, so a
    // reader with JS off gets nothing rather than a table of em dashes.
    for (const panel of document.querySelectorAll<HTMLElement>("[data-fp]")) {
        const playful = panel.dataset.voice === "playful";
        const mq = (q: string) => window.matchMedia(q).matches;
        const ua = navigator as any;

        const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
        const brand = (ua.userAgentData?.brands ?? []).find(
            (b: any) => !/Not.?A.?Brand/i.test(b.brand),
        );

        const facts: Record<string, string | undefined> = {
            timezone: zone,
            time: new Intl.DateTimeFormat("en-US", {
                hour: "numeric",
                minute: "2-digit",
            })
                .format(new Date())
                .toLowerCase(),
            language: navigator.language,
            screen: `${screen.width} × ${screen.height}${
                devicePixelRatio > 1 ? ` @${devicePixelRatio}x` : ""
            }`,
            platform: ua.userAgentData?.platform || undefined,
            engine: brand ? `${brand.brand} ${brand.version}` : undefined,
            theme: mq("(prefers-color-scheme: dark)")
                ? playful ? "off" : "dark"
                : playful ? "on" : "light",
            pointer: mq("(pointer: coarse)")
                ? playful ? "a finger" : "touch"
                : playful ? "a mouse" : "mouse",
            cores: navigator.hardwareConcurrency
                ? playful
                    ? `${navigator.hardwareConcurrency} cores`
                    : String(navigator.hardwareConcurrency)
                : undefined,
        };

        let shown = 0;

        for (const row of panel.querySelectorAll<HTMLElement>("[data-row]")) {
            const value = facts[row.dataset.row!];

            // A row nothing could answer is dropped, not left blank: Firefox
            // and Safari expose no userAgentData at all.
            if (!value) {
                row.remove();
                continue;
            }

            row.querySelector<HTMLElement>("[data-value]")!.textContent = value;
            shown++;
        }

        if (shown) panel.hidden = false;
    }
</script>
