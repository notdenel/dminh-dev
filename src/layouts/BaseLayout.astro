---
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "dminh.dev",
  description = "personal dev site of daniel sims",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased">
    <div class="mx-auto flex min-h-screen w-full max-w-3xl flex-col px-5 py-6 sm:px-6 sm:py-8">
      <slot />
    </div>
  </body>
</html>