---
import "../styles/global.css";
import { buildCommit } from "../utils/buildInfo";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "dminh.dev",
  description = "personal dev site of daniel sims",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <!-- Both of these exist to paint the page dark as early as possible.
         The meta applies before any stylesheet arrives; the inline rule
         paints the background before the external sheet does. Unconfirmed
         as the cause of the navigation flash — it could not be reproduced
         here across eight navigation paths — but it is the documented fix
         for a dark page flashing white before its CSS lands. -->
    <meta name="color-scheme" content="dark" />
    <style is:inline>
      html {
        background: #101014;
      }
    </style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=5" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="dminh.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#101014" />

    <title>{title}</title>
  </head>

  <body class="min-h-screen antialiased">
    <div
      class="mx-auto flex min-h-screen w-full max-w-3xl flex-col px-5 py-6 sm:px-6 sm:py-8"
    >
      <slot />
    </div>

    <!-- for anyone who opens the console -->
    <script is:inline define:vars={{ buildCommit }}>
      console.log(
        `%cdminh.dev%c
built from ${buildCommit ?? "an unknown commit"} · github.com/notdenel/dminh-dev
if you're reading this, we'd probably get along. say hi: dminhsims@gmail.com`,
        "color:#aa8ee1;font:600 15px ui-sans-serif,system-ui,sans-serif",
        "color:#878899;font:13px ui-monospace,monospace",
      );
    </script>

    <!-- global script to handle back buttons across site -->
    <script>
      // event delegation to record back button click
      document.body.addEventListener("click", (event) => {
        // find closest ancestor that's an anchor tag
        const target = event.target as HTMLElement;
        const backButton = target.closest("a.back-button");

        if (backButton && document.referrer) {
          try {
            const referrerOrigin = new URL(document.referrer).origin;
            const currentOrigin = window.location.origin;

            // only intercept if from own domain
            if (referrerOrigin === currentOrigin) {
              event.preventDefault();
              history.back();
            }
          } catch (error) {
            // URL parsing failed -> fallback href to home
          }
        }
      });
    </script>
  </body>
</html>
