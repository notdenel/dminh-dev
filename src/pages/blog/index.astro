---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionDivider from "../../components/SectionDivider.astro";
import PageHeader from "../../components/PageHeader.astro";
import BlogPostPreview from "../../components/BlogPostPreview.astro";
import TagRow from "../../components/TagRow.astro";
import { getCollection } from "astro:content";
import { formatDayMonth } from "../../utils/formatDate";
import { groupByYear } from "../../utils/groupByYear";

const posts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort(
    (a, b) => a.localeCompare(b),
);

const postsByYear = groupByYear(posts, (post) => post.data.pubDate);
---

<BaseLayout
    title="blog | dminh.dev"
    description="notes, project writeups, and thoughts by daniel sims"
>
    <Header />

    <main class="flex-1">
        <PageHeader
            title="blog"
            backHref="/"
            lede="a small collection of notes, project writeups, and thoughts on things i’m learning or building. and i occasionally yap!"
        />

        {
            tags.length > 0 && (
                <section class="mt-group space-y-3">
                    <h2 class="section-label">
                        tags
                    </h2>

                    <TagRow tags={tags} />
                </section>
            )
        }

        <SectionDivider />

        <div class="space-y-section">
            {
                postsByYear.map(([year, yearPosts]) => (
                    <section class="space-y-6">
                        <h2 class="year-heading">{year}</h2>

                        <div class="space-y-10">
                            {yearPosts.map((post) => (
                                <BlogPostPreview
                                    title={post.data.title}
                                    description={post.data.description}
                                    date={formatDayMonth(post.data.pubDate)}
                                    tags={post.data.tags}
                                    href={`/blog/${post.id}`}
                                />
                            ))}
                        </div>
                    </section>
                ))
            }
        </div>
    </main>

    <Footer />
</BaseLayout>
