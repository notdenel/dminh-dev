---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BackLink from "../../components/BackLink.astro";
import BlogCard from "../../components/BlogCard.astro";
import { blogPosts } from "../../data/blog";
---

<BaseLayout
    title="blog | dminh.dev"
    description="notes, project writeups, and thoughts by daniel sims"
>
    <Header />

    <main class="flex-1">
        <section class="space-y-4">
            <div class="mb-6">     
                <BackLink />
            </div>

            <h1
                class="text-4xl font-semibold tracking-tight text-zinc-50 sm:text-5xl"
            >
                blog
            </h1>

            <p class="max-w-2xl leading-7 text-zinc-400">
                a small collection of notes, project writeups, and thoughts on
                things i’m learning or building. for now, this is mostly a
                placeholder while the site takes shape.
            </p>
        </section>

        <section class="mt-12 space-y-4">
            {
                blogPosts.map((post) => (
                    <BlogCard
                        title={post.title}
                        description={post.description}
                        status={post.status}
                        href={post.href}
                    />
                ))
            }
        </section>
    </main>

    <Footer />
</BaseLayout>
