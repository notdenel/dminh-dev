---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionDivider from "../../components/SectionDivider.astro";
import ArticleHeader from "../../components/ArticleHeader.astro";
import ReadingProgress from "../../components/ReadingProgress.astro";
import HeadingAnchors from "../../components/HeadingAnchors.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { formatDisplayDate } from "../../utils/formatDate";
import { getReadingTime } from "../../utils/readingTime"; // time determined based on .md body

type Props = {
    post: CollectionEntry<"blog">;
};

export async function getStaticPaths() {
    const posts = await getCollection("blog", ({ data }) => {
        return import.meta.env.PROD ? data.draft !== true : true; // drafts can exist while developing
        // but draft posts are excluded from production builds
    });

    return posts.map((post) => ({
        params: { id: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const readingTime = getReadingTime(post.body ?? "");

const formattedPubDate = formatDisplayDate(post.data.pubDate);

const formattedUpdatedDate = post.data.updatedDate
    ? formatDisplayDate(post.data.updatedDate)
    : undefined;

const dateLabel = formattedUpdatedDate
    ? `${formattedPubDate} (updated ${formattedUpdatedDate})`
    : formattedPubDate;
---

<BaseLayout
    title={`${post.data.title} | dminh.dev`}
    description={post.data.description}
>
    <ReadingProgress />
    <HeadingAnchors />

    <Header />

    <main class="flex-1">
        <article class="mx-auto max-w-2xl">
            <ArticleHeader
                title={post.data.title}
                backHref="/blog"
                metadata={[dateLabel, readingTime]}
                tags={post.data.tags}
            />

            <SectionDivider />

            <div class="article-content mt-group">
                <Content />
            </div>
        </article>
    </main>

    <Footer />
</BaseLayout>
