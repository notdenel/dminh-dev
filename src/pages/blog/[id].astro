---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionDivider from "../../components/SectionDivider.astro";
import BackLink from "../../components/BackLink.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { formatDisplayDate } from "../../utils/formatDate";
import { getReadingTime } from "../../utils/readingTime"; // time determined based on .md body

type Props = {
    post: CollectionEntry<"blog">;
};

export async function getStaticPaths() {
    const posts = await getCollection("blog", ({ data }) => {
        return import.meta.env.PROD ? data.draft !== true : true; // drafts can exist while developing
        // but draft posts are excluded from production builds
    });

    return posts.map((post) => ({
        params: { id: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const readingTime = getReadingTime(post.body ?? "");

const formattedPubDate = formatDisplayDate(post.data.pubDate);

const formattedUpdatedDate = post.data.updatedDate
    ? formatDisplayDate(post.data.updatedDate)
    : undefined;

const dateLabel = formattedUpdatedDate
    ? `${formattedPubDate} (updated ${formattedUpdatedDate})`
    : formattedPubDate;
---

<BaseLayout
    title={`${post.data.title} | dminh.dev`}
    description={post.data.description}
>
    <Header />

    <main class="flex-1">
        <article class="mx-auto max-w-2xl">
            <div class="space-y-8">
                <div class="mb-6">
                    <BackLink />
                </div>

                <header>
                    <h1
                        class="text-4xl font-semibold tracking-tight text-zinc-50 sm:text-5xl"
                    >
                        {post.data.title}
                    </h1>

                    <p
                        class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-medium italic text-zinc-500"
                    >
                        <span>{dateLabel}</span>
                        <span class="metadata-separator" aria-hidden="true"
                            >•</span
                        >
                        <span>{readingTime}</span>
                    </p>

                    {
                        post.data.tags.length > 0 && (
                            <div class="mt-4 flex flex-wrap gap-2">
                                {post.data.tags.map((tag) => (
                                    <a
                                        href={`/blog/tags/${encodeURIComponent(tag)}`}
                                        class="tag-pill"
                                    >
                                        #{tag}
                                    </a>
                                ))}
                            </div>
                        )
                    }
                </header>

                <SectionDivider />

                <div class="mt-8 article-content">
                    <Content />
                </div>
            </div>
        </article>
    </main>

    <Footer />
</BaseLayout>
