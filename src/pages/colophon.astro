---
// The design system, rendered from its own tokens. It exists so the post about
// building this site can show the palette and the scale without screenshots
// that go stale the first time a colour is retuned.
//
// Not in the nav on purpose: it is a reference, reached from the writing.
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import PaletteSwatches from "../components/PaletteSwatches.astro";
import TypeSpecimen from "../components/TypeSpecimen.astro";
---

<BaseLayout
    title="colophon | dminh.dev"
    description="the colours, type scale and typefaces this site is built from, rendered from its own tokens"
>
    <Header />

    <main class="flex-1">
        <PageHeader
            title="colophon"
            backHref="/"
            lede="the palette and the type scale this site runs on. everything below is rendered from the same tokens the site itself uses, so it cannot drift out of date — if a colour changes, this page changes with it."
        />

        <section class="mt-section space-y-6">
            <h2 class="section-label">accent</h2>
            <PaletteSwatches group="accent" />
        </section>

        <section class="mt-section space-y-6">
            <h2 class="section-label">text</h2>
            <PaletteSwatches group="neutral" />
        </section>

        <section class="mt-section space-y-6">
            <h2 class="section-label">surfaces</h2>
            <PaletteSwatches group="surface" />
        </section>

        <section class="mt-section space-y-6">
            <h2 class="section-label">type scale</h2>
            <TypeSpecimen />
        </section>
    </main>

    <Footer />
</BaseLayout>
