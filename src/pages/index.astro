---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import BlogPostPreview from "../components/BlogPostPreview.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { formatDisplayDate } from "../utils/formatDate";

const recentBlogPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const featuredProjects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout title="dminh.dev" description="personal dev site of daniel sims">
  <Header />

  <main class="flex-1">
    <PageHeader
      title="hi, i'm daniel!"
      lede="i recently graduated with a degree in computer science & engineering, and am currently navigating the world of cybersecurity, systems, and software. i enjoy understanding why things work, bend, or break."
    >
      <p
        class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-semibold text-zinc-500"
      >
        <span>san jose, ca</span>
        <span class="metadata-separator" aria-hidden="true">•</span>
        <span>open to work</span>
      </p>
    </PageHeader>

    <section class="mt-16 space-y-4">
      <h2 class="text-sm font-semibold lowercase tracking-wide text-zinc-500">
        currently
      </h2>

      <ul class="font-copy space-y-3 text-lg text-zinc-300">
        <li>building a cybersecurity home lab</li>
        <li>studying for network+ and ccna</li>
        <li>making small projects for fun</li>
        <li>learning how to play hockey</li>
        <li>
          looking for entry-level cybersecurity and software engineering roles
        </li>
      </ul>
    </section>

    <section class="mt-16 space-y-6">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-sm font-semibold lowercase tracking-wide text-zinc-500">
          blog
        </h2>

        <a href="/blog" class="site-link text-sm font-semibold"> view all → </a>
      </div>

      <div class="space-y-10">
        {
          recentBlogPosts.map((post) => (
            <BlogPostPreview
              title={post.data.title}
              description={post.data.description}
              date={formatDisplayDate(post.data.pubDate)}
              tags={post.data.tags}
              href={`/blog/${post.id}`}
            />
          ))
        }
      </div>
    </section>

    <section class="mt-16 space-y-6">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-sm font-semibold lowercase tracking-wide text-zinc-500">
          projects
        </h2>

        <a href="/projects" class="site-link text-sm font-semibold">
          view all →
        </a>
      </div>

      <div class="space-y-4">
        {
          featuredProjects.map((project) => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              technologies={project.data.technologies}
              status={project.data.status}
              href={`/projects/${project.id}/`}
            />
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
