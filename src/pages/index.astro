---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BlogPostPreview from "../components/BlogPostPreview.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
import { getCollection } from "astro:content";
import { formatDisplayDate } from "../utils/formatDate";

const featuredBlogPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft && post.data.featured)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const featuredProjects = projects.filter((project) => project.featured);
---

<BaseLayout title="dminh.dev" description="personal dev site of daniel sims">
  <Header />

  <main class="flex-1">
    <section class="space-y-6">
      <div class="space-y-4">
        <h1
          class="text-4xl font-semibold tracking-tight text-zinc-50 sm:text-5xl"
        >
          hi, i'm daniel!
        </h1>

        <p class="max-w-2xl text-lg leading-8 text-zinc-300">
          i recently graduated with a degree in computer science & engineering,
          and am currently navigating the world of cybersecurity, systems, and
          software. i enjoy understanding why things work, bend, or break.
        </p>

        <p class="text-sm text-zinc-500">san jose, ca · open to work</p>
      </div>
    </section>

    <section class="mt-16 space-y-4">
      <h2 class="text-sm font-medium lowercase tracking-wide text-zinc-500">
        currently
      </h2>

      <ul class="space-y-3 text-zinc-300">
        <li>building a cybersecurity home lab</li>
        <li>studying for network+ and ccna</li>
        <li>making small projects for fun</li>
        <li>learning how to play hockey</li>
        <li>
          looking for entry-level cybersecurity and software engineering roles
        </li>
      </ul>
    </section>

    <section class="mt-16 space-y-6">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-sm font-medium lowercase tracking-wide text-zinc-500">
          blog
        </h2>

        <a href="/blog" class="site-link text-sm"> view all → </a>
      </div>

      <div class="space-y-10">
        {
          featuredBlogPosts.map((post) => (
            <BlogPostPreview
              title={post.data.title}
              description={post.data.description}
              date={formatDisplayDate(post.data.pubDate)}
              tags={post.data.tags}
              href={`/blog/${post.id}`}
            />
          ))
        }
      </div>
    </section>

    <section class="mt-16 space-y-6">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-sm font-medium lowercase tracking-wide text-zinc-500">
          projects
        </h2>

        <a href="/projects" class="site-link text-sm"> view all → </a>
      </div>

      <div class="space-y-4">
        {
          featuredProjects.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              tags={project.tags}
              href={project.href}
            />
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
