---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import BlogPostPreview from "../components/BlogPostPreview.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { getCollection } from "astro:content";
import { formatDisplayDate, formatYearRail } from "../utils/formatDate";
import { PHRASES } from "../utils/phrases";
import NowPlaying from "../components/NowPlaying.astro";

const recentBlogPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const featuredProjects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout title="dminh.dev" description="personal dev site of daniel sims">
  <Header />

  <main class="flex-1">
    <PageHeader
      title="hi, i'm daniel!"
      lede="i recently graduated with a degree in computer science & engineering, and am currently navigating the world of cybersecurity, systems, and software. i enjoy understanding why things work, and why they don't."
    >
      <p class="typed-line">
        right now i'm <span class="typed-text" data-typed>{PHRASES[0]}</span><span
          class="caret"
          aria-hidden="true"></span>
      </p>

      <p
        class="flex flex-wrap items-center gap-x-3 gap-y-1 text-ui font-semibold tabular-nums text-muted"
      >
        <span>san jose, ca</span>

        {/* Both start hidden: without JS the row reads "san jose, ca • open
            to work" with no dangling separator. */}
        <span class="metadata-separator" data-clock aria-hidden="true" hidden>
          •
        </span>
        <span data-clock hidden></span>

        <span class="metadata-separator" aria-hidden="true">•</span>
        <span>open to work</span>
      </p>

      <NowPlaying />
    </PageHeader>

    <section class="mt-16 space-y-6">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-ui font-semibold lowercase tracking-wide text-muted">
          blog
        </h2>

        <a href="/blog" class="site-link text-ui font-semibold"> view all → </a>
      </div>

      <div class="space-y-10">
        {
          recentBlogPosts.map((post) => (
            <BlogPostPreview
              title={post.data.title}
              description={post.data.description}
              date={formatDisplayDate(post.data.pubDate)}
              tags={post.data.tags}
              href={`/blog/${post.id}`}
            />
          ))
        }
      </div>
    </section>

    <section class="mt-16 space-y-6">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-ui font-semibold lowercase tracking-wide text-muted">
          projects
        </h2>

        <a href="/projects" class="site-link text-ui font-semibold">
          view all →
        </a>
      </div>

      <div class="project-list">
        {
          featuredProjects.map((project) => (
            <ProjectRow
              title={project.data.title}
              description={project.data.description}
              technologies={project.data.technologies}
              designation={project.data.type}
              yearRail={formatYearRail(
                project.data.startDate,
                project.data.endDate,
              )}
              href={`/projects/${project.id}`}
            />
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { PHRASES } from "../utils/phrases";
import NowPlaying from "../components/NowPlaying.astro";

  // ── his local time ──────────────────────────────────────────────────────
  // A static build bakes the build time, so this has to be client-side. It
  // renders once rather than ticking: a clock that updates in front of the
  // reader would spend loud-flair budget the typed line already owns.
  const clock = document.querySelectorAll("[data-clock]");

  if (clock.length) {
    const time = new Intl.DateTimeFormat("en-US", {
      timeZone: "America/Los_Angeles",
      hour: "numeric",
      minute: "2-digit",
    })
      .format(new Date())
      .toLowerCase();

    clock[clock.length - 1].textContent = time;
    clock.forEach((el) => ((el as HTMLElement).hidden = false));
  }

  // ── the typed line ──────────────────────────────────────────────────────
  const typed = document.querySelector("[data-typed]");
  const caret = typed?.nextElementSibling;

  if (typed && caret) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      // Every phrase at once, no caret. A reduced-motion reader should lose
      // the animation, not the content it was carrying.
      typed.textContent = PHRASES.join(" · ");
    } else {
      // The markup already shows PHRASES[0], so the loop opens on the pause
      // after typing it rather than clearing the line and reflowing.
      let phrase = 0;
      let chars = PHRASES[0].length;
      let deleting = true;

      // Timings are about impersonating a person, not about speed.
      const TYPE = 45;
      const HOLD = 2700; // sitting on a finished phrase, reading it back
      const THINK = 1250; // sitting on "right now i'm", deciding what is next
      const BACKSPACE = 320; // the beat before a held key starts repeating
      const REPEAT = 18; // and then the rest run away at once

      const idle = (on: boolean) => caret.classList.toggle("is-idle", on);

      const tick = () => {
        const full = PHRASES[phrase];
        chars += deleting ? -1 : 1;
        typed.textContent = full.slice(0, chars);

        if (!deleting && chars === full.length) {
          idle(true);
          deleting = true;
          setTimeout(tick, HOLD);
          return;
        }

        if (deleting && chars === 0) {
          idle(true);
          deleting = false;
          phrase = (phrase + 1) % PHRASES.length;
          setTimeout(tick, THINK);
          return;
        }

        idle(false);

        // One character goes, then a pause, then the key repeat catches up —
        // which is what holding backspace actually feels like.
        setTimeout(
          tick,
          !deleting
            ? TYPE
            : chars === full.length - 1
              ? BACKSPACE
              : REPEAT,
        );
      };

      caret.classList.add("is-typing", "is-idle");
      setTimeout(tick, 1900);
    }
  }
</script>
