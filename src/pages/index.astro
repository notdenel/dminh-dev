---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Daniel Sims | Cybersecurity / Software Engineering</title>
    <meta
      name="description"
      content="Hello! I'm a recent Computer Science and Engineering graduate focused on cybersecurity and software engineering."
    />
  </head>

  <body class="min-h-screen bg-neutral-950 text-neutral-100">
    <main class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center px-6 py-16">
      <p class="mb-4 text-sm uppercase tracking-[0.3em] text-neutral-400">
        dminh.dev
      </p>

      <h1 class="text-4xl font-bold tracking-tight sm:text-6xl">
        Daniel Sims
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-neutral-300">
        Recent Computer Science and Engineering graduate focused on cybersecurity and software engineering.
      </p>

      <div class="mt-8 flex flex-wrap gap-3 text-sm">
        <a
          class="rounded-full border border-neutral-700 px-4 py-2 hover:border-neutral-300"
          href="https://github.com/notdenel"
        >
          GitHub
        </a>

        <a
          class="rounded-full border border-neutral-700 px-4 py-2 hover:border-neutral-300"
          href="https://www.linkedin.com/in/dminhsims/"
        >
          LinkedIn
        </a>

        <a
          class="rounded-full border border-neutral-700 px-4 py-2 hover:border-neutral-300"
          href="mailto:dminhsims@gmail.com"
        >
          Email
        </a>
      </div>
    </main>
  </body>
</html>
