---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BlogCard from "../components/BlogCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
---

<BaseLayout title="dminh.dev" description="personal dev site of daniel sims">
  <Header />

  <main class="flex-1">
    <section class="space-y-6">
      <!-- <p class="text-sm text-zinc-500">personal site / home</p> -->

      <div class="space-y-4">
        <h1
          class="text-4xl font-semibold tracking-tight text-zinc-50 sm:text-5xl"
        >
          hi, i'm daniel!
        </h1>

        <p class="max-w-2xl text-lg leading-8 text-zinc-300">
          i recently graduated with a degree in computer science & engineering,
          and am currently navigating the world of cybersecurity, systems, and
          software. i enjoy understanding why things work, bend, or break.
        </p>
      </div>
    </section>

    <section class="mt-16 space-y-4">
      <h2 class="text-sm font-medium lowercase tracking-wide text-zinc-500">
        currently
      </h2>

      <ul class="space-y-3 text-zinc-300">
        <li>building a cybersecurity home lab</li>
        <li>studying for my network+ and security+ exams</li>
        <li>making fun projects</li>
        <li>learning how to play hockey</li>
        <li>
          looking for entry-level cybersecurity and software engineering roles
        </li>
      </ul>
    </section>

    <section class="mt-16 space-y-6">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-sm font-medium lowercase tracking-wide text-zinc-500">
          blog
        </h2>

        <a href="/blog" class="text-sm text-zinc-500 hover:text-zinc-300">
          view all →
        </a>
      </div>

      <div class="space-y-4">
        <BlogCard
          title="building my cybersecurity home lab"
          description="notes on setting up an isolated lab for networking, traffic analysis, dns filtering, and defensive security practice."
        />

        <BlogCard
          title="welcome to my blog"
          description="a space where i yap about whatever!"
        />
      </div>
    </section>

    <section class="mt-16 space-y-6">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-sm font-medium lowercase tracking-wide text-zinc-500">
          projects
        </h2>

        <a href="/projects" class="text-sm text-zinc-500 hover:text-zinc-300">
          view all →
        </a>
      </div>

      <div class="space-y-4">
        <ProjectCard
          title="cybersecurity home lab"
          description="an isolated lab using linux and windows virtual machines, vmware, wireshark, and pi-hole to practice networking, traffic analysis, dns-level filtering, and defensive workflows."
          tags={["vmware", "linux", "windows", "wireshark", "pi-hole"]}
        />

        <ProjectCard
          title="simple c compiler"
          description="a multi-phase compiler for a subset of c, including lexical analysis, parsing, semantic analysis, scoped symbol tables, type checking, and x86/linux assembly generation."
          tags={["c++", "x86 assembly", "linux", "gdb"]}
        />

        <ProjectCard
          title="multi-agent robot formation control"
          description="a senior capstone project involving decentralized robot formation control, matlab/simulink simulation, ros 2 integration, slam/amcl localization, and ekf-based pose estimation."
          tags={[
            "ros 2",
            "matlab/simulink",
            "slam/amcl",
            "ekf",
            "raspberry pi",
          ]}
        />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
