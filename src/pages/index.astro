---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="dminh.dev"
  description="personal dev site of daniel sims"
>
  <Header />

  <main class="flex-1">
    <section class="space-y-6">
      <!-- <p class="text-sm text-zinc-500">personal site / home</p> -->

      <div class="space-y-4">
        <h1 class="text-4xl font-semibold tracking-tight text-zinc-50 sm:text-5xl">
          hi, i'm daniel!
        </h1>

        <p class="max-w-2xl text-lg leading-8 text-zinc-300">
          i recently graduated with a degree in computer science & engineering,
          and am currently navigating the world of cybersecurity, systems, and
          software. i enjoy understanding why things works, bend, or break.
        </p>

        <!-- <p class="max-w-2xl leading-7 text-zinc-400">
          i like puzzles, computers, games, networks, and understanding why
          things work, bend, or break.
        </p> -->
      </div>
    </section>

    <section class="mt-16 space-y-4">
      <h2 class="text-sm font-medium lowercase tracking-wide text-zinc-500">
        currently
      </h2>

      <ul class="space-y-3 text-zinc-300">
        <li>building a cybersecurity home lab</li>
        <li>studying for my network+ and security+ exams</li>
        <li>making fun projects</li>
        <li>learning how to play hockey</li>
        <li>looking for entry-level cybersecurity and software engineering roles</li>
      </ul>
    </section>

    <section class="mt-16 space-y-6">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-sm font-medium lowercase tracking-wide text-zinc-500">
          blog
        </h2>

        <a href="/writing" class="text-sm text-zinc-500 hover:text-zinc-300">
          view all
        </a>
      </div>

      <div class="space-y-4">
        <article class="rounded-lg border border-zinc-800 p-5">
          <p class="mb-2 text-sm text-zinc-500">coming soon</p>
          <h3 class="font-medium text-zinc-100">
            building my cybersecurity home lab
          </h3>
          <p class="mt-2 leading-7 text-zinc-400">
            notes on setting up an isolated lab for networking, traffic
            analysis, dns filtering, and defensive security practice.
          </p>
        </article>

        <article class="rounded-lg border border-zinc-800 p-5">
          <p class="mb-2 text-sm text-zinc-500">coming soon</p>
          <h3 class="font-medium text-zinc-100">
            welcome to my blog
          </h3>
          <p class="mt-2 leading-7 text-zinc-400">
            a space where i yap about whatever!
          </p>
        </article>
      </div>
    </section>

    <section class="mt-16 space-y-6">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-sm font-medium lowercase tracking-wide text-zinc-500">
          projects
        </h2>

        <a href="/projects" class="text-sm text-zinc-500 hover:text-zinc-300">
          view all
        </a>
      </div>

      <div class="space-y-4">
        <article class="rounded-xl border border-zinc-800 p-5">
          <h3 class="font-medium text-zinc-100">cybersecurity home lab</h3>
          <p class="mt-2 leading-7 text-zinc-400">
            an isolated lab using linux and windows virtual machines, vmware,
            wireshark, and pi-hole to practice networking, traffic analysis,
            dns-level filtering, and defensive workflows.
          </p>
          <p class="mt-3 text-sm text-zinc-500">
            vmware · linux · windows · wireshark · pi-hole
          </p>
        </article>

        <article class="rounded-xl border border-zinc-800 p-5">
          <h3 class="font-medium text-zinc-100">simple c compiler</h3>
          <p class="mt-2 leading-7 text-zinc-400">
            a multi-phase compiler for a subset of c, including lexical
            analysis, parsing, semantic analysis, scoped symbol tables, type
            checking, and x86/linux assembly generation.
          </p>
          <p class="mt-3 text-sm text-zinc-500">
            c++ · x86 assembly · linux · gdb
          </p>
        </article>

        <article class="rounded-xl border border-zinc-800 p-5">
          <h3 class="font-medium text-zinc-100">
            multi-agent robot formation control
          </h3>
          <p class="mt-2 leading-7 text-zinc-400">
            a senior capstone project involving decentralized robot formation
            control, matlab/simulink simulation, ros 2 integration, slam/amcl
            localization, and ekf-based pose estimation.
          </p>
          <p class="mt-3 text-sm text-zinc-500">
            ros 2 · matlab/simulink · slam/amcl · ekf · raspberry pi
          </p>
        </article>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>