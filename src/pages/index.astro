---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import BlogPostPreview from "../components/BlogPostPreview.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { getCollection } from "astro:content";
import { formatDisplayDate, formatYearRail } from "../utils/formatDate";
import { PHRASES } from "../utils/phrases";
import NowPlaying from "../components/NowPlaying.astro";

const recentBlogPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const featuredProjects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout title="dminh.dev" description="personal dev site of daniel sims">
  <Header />

  <main class="flex-1">
    <PageHeader
      title="hi, i'm daniel!"
      lede="a recent computer science & engineering graduate, navigating cybersecurity, systems, and software. i enjoy understanding why things work, and why they don't."
    >
    </PageHeader>

    <section class="mt-section space-y-6">
      <h2 class="section-label">right now</h2>

      <dl class="now-grid">
        <div>
          <dt>working on</dt>
          <dd class="is-live">
            <span class="typed-text" data-typed>{PHRASES[0].text}</span><span
              class="caret"
              aria-hidden="true"></span>
          </dd>
        </div>

        <div>
          <dt>based in</dt>
          <dd class="metadata-row">
            san jose, ca<span data-clock hidden> — </span><span
              data-clock
              hidden></span>
          </dd>
        </div>

        <div>
          <dt>status</dt>
          <dd>open to work</dd>
        </div>

        <NowPlaying />
      </dl>
    </section>

    <section class="mt-section space-y-6">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="section-label">
          blog
        </h2>

        <a href="/blog" class="site-link text-ui font-semibold"> view all → </a>
      </div>

      <div class="space-y-10">
        {
          recentBlogPosts.map((post) => (
            <BlogPostPreview
              title={post.data.title}
              description={post.data.description}
              date={formatDisplayDate(post.data.pubDate)}
              tags={post.data.tags}
              href={`/blog/${post.id}`}
            />
          ))
        }
      </div>
    </section>

    <section class="mt-section space-y-6">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="section-label">
          projects
        </h2>

        <a href="/projects" class="site-link text-ui font-semibold">
          view all →
        </a>
      </div>

      <div class="project-list">
        {
          featuredProjects.map((project) => (
            <ProjectRow
              title={project.data.title}
              description={project.data.description}
              technologies={project.data.technologies}
              designation={project.data.type}
              yearRail={formatYearRail(
                project.data.startDate,
                project.data.endDate,
              )}
              href={`/projects/${project.id}`}
            />
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { PHRASES, type Phrase } from "../utils/phrases";

  // ── his local time ──────────────────────────────────────────────────────
  // A static build bakes the build time, so this has to be client-side. It
  // wakes on the minute boundary rather than on an interval, so the digits
  // change at the moment they actually change and never sit stale.
  const clock = document.querySelectorAll("[data-clock]");

  if (clock.length) {
    const face = clock[clock.length - 1];

    const showTime = () => {
      face.textContent = new Intl.DateTimeFormat("en-US", {
        timeZone: "America/Los_Angeles",
        hour: "numeric",
        minute: "2-digit",
      })
        .format(new Date())
        .toLowerCase();
    };

    const nextMinute = () => {
      showTime();
      setTimeout(nextMinute, 60_000 - (Date.now() % 60_000) + 200);
    };

    nextMinute();
    clock.forEach((el) => ((el as HTMLElement).hidden = false));

    // A background tab has its timers throttled, so the wake-up above can be
    // late by minutes. Re-read on the way back rather than trust it.
    document.addEventListener("visibilitychange", showTime);
  }

  // ── the typed line ──────────────────────────────────────────────────────
  const typed = document.querySelector("[data-typed]");
  const caret = typed?.nextElementSibling;

  if (typed && caret) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      // Every phrase at once, no caret. A reduced-motion reader should lose
      // the animation, not the content it was carrying.
      typed.textContent = PHRASES.map((p) => p.text).join(" · ");
    } else {
      // The markup already shows PHRASES[0], so the loop opens on the pause
      // after typing it rather than clearing the line and reflowing.
      let phrase = 0;
      let chars = PHRASES[0].text.length;
      let deleting = true;

      // Timings are about impersonating a person, not about speed.
      const TYPE = 45;
      const HOLD = 2700; // sitting on a finished phrase, reading it back
      const THINK = 1250; // sitting on "right now i'm", deciding what is next
      const DOT = 300; // before each period of an ellipsis
      const ELLIPSIS = 1900; // the beat the ellipsis is there to buy
      // Windows' own key-repeat settings, read off this machine:
      // HKCU\Control Panel\Keyboard KeyboardDelay=1, KeyboardSpeed=31.
      const BACKSPACE = 500; // the delay before a held key starts repeating
      const REPEAT = 25; // then a repeat rate between Windows' and the old one

      const idle = (on: boolean) => caret.classList.toggle("is-idle", on);

      // A general rule, not a special case for one phrase: any run of two or
      // more periods anywhere in any phrase is typed slowly and held on. A
      // lone period ending a sentence is not a run and is typed normally.
      const inRun = (s: string, i: number) =>
        s[i] === "." && (s[i + 1] === "." || s[i - 1] === ".");

      // What to wait after having just written character `chars` of `text`.
      const pause = (text: string, chars: number) => {
        if (deleting) return chars === text.length - 1 ? BACKSPACE : REPEAT;
        if (inRun(text, chars)) return DOT; // a period of a run comes next
        if (inRun(text, chars - 1)) return ELLIPSIS; // the run just closed
        return TYPE;
      };

      // The linked word only becomes a real link once it is whole — a
      // half-typed href is not something to hand a reader.
      const paint = (p: Phrase, chars: number) => {
        const shown = p.text.slice(0, chars);
        const start = p.link ? p.text.indexOf(p.link.word) : -1;

        if (!p.link || start < 0 || chars <= start) {
          typed.textContent = shown;
          return;
        }

        const end = start + p.link.word.length;
        const mark = document.createElement("a");
        mark.className = "typed-mark";
        mark.textContent = shown.slice(start, end);

        if (chars >= end) {
          mark.href = p.link.href;
          mark.target = "_blank";
          mark.rel = "noreferrer";
        }

        typed.replaceChildren(shown.slice(0, start), mark, shown.slice(end));
      };

      const tick = () => {
        const p = PHRASES[phrase];
        chars += deleting ? -1 : 1;
        paint(p, chars);

        if (!deleting && chars === p.text.length) {
          idle(true);
          deleting = true;
          setTimeout(tick, HOLD);
          return;
        }

        if (deleting && chars === 0) {
          idle(true);
          deleting = false;
          phrase = (phrase + 1) % PHRASES.length;
          setTimeout(tick, THINK);
          return;
        }

        // One character goes, then a pause, then the key repeat catches up —
        // which is what holding backspace actually feels like.
        const wait = pause(p.text, chars);
        idle(wait === ELLIPSIS);
        setTimeout(tick, wait);
      };

      caret.classList.add("is-typing", "is-idle");
      setTimeout(tick, 1900);
    }
  }
</script>
