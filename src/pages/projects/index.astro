---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BackLink from "../../components/BackLink.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import SectionDivider from "../../components/SectionDivider.astro";

const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
    title="projects | dminh.dev"
    description="projects in cybersecurity, systems, software, and robotics by daniel sims"
>
    <Header />

    <main class="flex-1">
        <section class="space-y-4">
            <div class="mb-6">
                <BackLink />
            </div>

            <h1
                class="text-4xl font-semibold tracking-tight text-zinc-50 sm:text-5xl"
            >
                projects
            </h1>

            <p class="font-copy max-w-2xl leading-8 text-lg text-zinc-300">
                a small archive of projects from school, personal learning, and
                independent tinkering. some are polished, some are still
                evolving, and some are mainly here because they taught me
                something useful.
            </p>
        </section>

        <SectionDivider />

        <div class="mt-8 space-y-4">
            {
                projects.map((project) => (
                    <ProjectCard
                        title={project.data.title}
                        description={project.data.description}
                        technologies={project.data.technologies}
                        status={project.data.status}
                        href={`/projects/${project.id}/`}
                    />
                ))
            }
        </div>
    </main>

    <Footer />
</BaseLayout>
