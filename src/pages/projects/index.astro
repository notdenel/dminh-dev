---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectCard from "../../components/ProjectCard.astro";
---

<BaseLayout
    title="projects | dminh.dev"
    description="projects in cybersecurity, systems, software, and robotics by daniel sims"
>
    <Header />

    <main class="flex-1">
        <section class="space-y-4">
            <div class="mb-6">
                <a
                    href="/"
                    class="back-button text-sm text-zinc-500 hover:text-zinc-300"
                >
                    ← back
                </a>
            </div>

            <h1
                class="text-4xl font-semibold tracking-tight text-zinc-50 sm:text-5xl"
            >
                projects
            </h1>

            <p class="max-w-2xl leading-7 text-zinc-400">
                a small archive of projects from school, personal learning, and
                independent tinkering. some are polished, some are still
                evolving, and some are mainly here because they taught me
                something useful.
            </p>
        </section>

        <section class="mt-12 space-y-4">
            <ProjectCard
                title="cybersecurity home lab"
                description="an isolated lab using linux and windows virtual machines, vmware, wireshark, and pi-hole to practice networking, traffic analysis, dns-level filtering, and defensive workflows."
                tags={["vmware", "linux", "windows", "wireshark", "pi-hole"]}
            />

            <ProjectCard
                title="simple c compiler"
                description="a multi-phase compiler for a subset of c, including lexical analysis, parsing, semantic analysis, scoped symbol tables, type checking, and x86/linux assembly generation."
                tags={["c++", "x86 assembly", "linux", "gdb"]}
            />

            <ProjectCard
                title="multi-agent robot formation control"
                description="a senior capstone project involving decentralized robot formation control, matlab/simulink simulation, ros 2 integration, slam/amcl localization, and ekf-based pose estimation."
                tags={[
                    "ros 2",
                    "matlab/simulink",
                    "slam/amcl",
                    "ekf",
                    "raspberry pi",
                ]}
            />
        </section>
    </main>

    <Footer />
</BaseLayout>
