---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHeader from "../../components/PageHeader.astro";
import ProjectRow from "../../components/ProjectRow.astro";

import { formatYearRail } from "../../utils/formatDate";

const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
    title="projects | dminh.dev"
    description="projects in cybersecurity, systems, software, and robotics by daniel sims"
>
    <Header />

    <main class="flex-1">
        <PageHeader
            title="projects"
            backHref="/"
            lede="a small archive of projects from school, personal learning, and independent tinkering. some are polished, some are still evolving, and some are mainly here because they taught me something useful."
        />

        <div class="project-list mt-10">
            {
                projects.map((project) => (
                    <ProjectRow
                        title={project.data.title}
                        description={project.data.description}
                        technologies={project.data.technologies}
                        designation={project.data.type}
                        yearRail={formatYearRail(
                            project.data.startDate,
                            project.data.endDate,
                        )}
                        href={`/projects/${project.id}`}
                    />
                ))
            }
        </div>
    </main>

    <Footer />
</BaseLayout>
