---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHeader from "../../components/PageHeader.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import SectionDivider from "../../components/SectionDivider.astro";

const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
    title="projects | dminh.dev"
    description="projects in cybersecurity, systems, software, and robotics by daniel sims"
>
    <Header />

    <main class="flex-1">
        <PageHeader
            title="projects"
            backHref="/"
            lede="a small archive of projects from school, personal learning, and independent tinkering. some are polished, some are still evolving, and some are mainly here because they taught me something useful."
        />

        <SectionDivider />

        <div class="mt-8 space-y-4">
            {
                projects.map((project) => (
                    <ProjectCard
                        title={project.data.title}
                        description={project.data.description}
                        technologies={project.data.technologies}
                        status={project.data.status}
                        href={`/projects/${project.id}`}
                    />
                ))
            }
        </div>
    </main>

    <Footer />
</BaseLayout>
