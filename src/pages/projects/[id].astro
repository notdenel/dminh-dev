---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionDivider from "../../components/SectionDivider.astro";
import BackLink from "../../components/BackLink.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { formatMonthYearRange } from "../../utils/formatDate";

type Props = {
    project: CollectionEntry<"projects">;
};

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    return projects.map((project) => ({
        params: { id: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const dateRange = formatMonthYearRange(
    project.data.startDate,
    project.data.endDate,
);
---

<BaseLayout
    title={`${project.data.title} | dminh.dev`}
    description={project.data.description}
>
    <Header />

    <main class="flex-1">
        <article class="mx-auto max-w-2xl">
            <div class="space-y-8">
                <div class="mb-6">
                    <BackLink />
                </div>

                <header>
                    <h1
                        class="mt-5 text-4xl font-semibold tracking-tight text-zinc-50 sm:text-5xl"
                    >
                        {project.data.title}
                    </h1>

                    <p
                        class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-semibold italic text-zinc-500"
                    >
                        <span>{project.data.status}</span>

                        {
                            dateRange && (
                                <>
                                    <span
                                        class="metadata-separator"
                                        aria-hidden="true"
                                    >
                                        •
                                    </span>
                                    <span>{dateRange}</span>
                                </>
                            )
                        }
                    </p>

                    {
                        project.data.technologies.length > 0 && (
                            <div class="mt-4 flex flex-wrap gap-2">
                                {project.data.technologies.map((technology) => (
                                    <span class="tech-pill">{technology}</span>
                                ))}
                            </div>
                        )
                    }

                    {
                        (project.data.repoUrl ||
                            project.data.demoUrl ||
                            project.data.writeupUrl) && (
                            <div class="mt-6 flex flex-wrap gap-4 text-sm font-semibold">
                                {project.data.repoUrl && (
                                    <a
                                        href={project.data.repoUrl}
                                        class="site-link"
                                        target="_blank"
                                        rel="noreferrer"
                                    >
                                        github →
                                    </a>
                                )}

                                {project.data.demoUrl && (
                                    <a
                                        href={project.data.demoUrl}
                                        class="site-link"
                                        target="_blank"
                                        rel="noreferrer"
                                    >
                                        demo →
                                    </a>
                                )}

                                {project.data.writeupUrl && (
                                    <a
                                        href={project.data.writeupUrl}
                                        class="site-link"
                                    >
                                        related writeup →
                                    </a>
                                )}
                            </div>
                        )
                    }
                </header>

                <SectionDivider />

                <div class="article-content mt-8">
                    <Content />
                </div>
            </div>
        </article>
    </main>

    <Footer />
</BaseLayout>
