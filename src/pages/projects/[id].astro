---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionDivider from "../../components/SectionDivider.astro";
import ArticleHeader from "../../components/ArticleHeader.astro";
import ReadingProgress from "../../components/ReadingProgress.astro";
import HeadingAnchors from "../../components/HeadingAnchors.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { formatMonthYearRange } from "../../utils/formatDate";

type Props = {
    project: CollectionEntry<"projects">;
};

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    return projects.map((project) => ({
        params: { id: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const dateRange = formatMonthYearRange(
    project.data.startDate,
    project.data.endDate,
);
---

<BaseLayout
    title={`${project.data.title} | dminh.dev`}
    description={project.data.description}
>
    <ReadingProgress />
    <HeadingAnchors />

    <Header />

    <main class="flex-1">
        <article class="mx-auto max-w-2xl">
            <ArticleHeader
                title={project.data.title}
                backHref="/projects"
                metadata={dateRange
                    ? [project.data.status, dateRange]
                    : [project.data.status]}
                technologies={project.data.technologies}
            >
                {
                    (project.data.repoUrl ||
                        project.data.demoUrl ||
                        project.data.writeupUrl) && (
                        <div class="flex flex-wrap gap-4 text-ui font-semibold">
                            {project.data.repoUrl && (
                                <a
                                    href={project.data.repoUrl}
                                    class="site-link"
                                    target="_blank"
                                    rel="noreferrer"
                                >
                                    github →
                                </a>
                            )}

                            {project.data.demoUrl && (
                                <a
                                    href={project.data.demoUrl}
                                    class="site-link"
                                    target="_blank"
                                    rel="noreferrer"
                                >
                                    demo →
                                </a>
                            )}

                            {project.data.writeupUrl && (
                                <a
                                    href={project.data.writeupUrl}
                                    class="site-link"
                                >
                                    related writeup →
                                </a>
                            )}
                        </div>
                    )
                }
            </ArticleHeader>

            <SectionDivider />

            <div class="article-content mt-group">
                <Content />
            </div>
        </article>
    </main>

    <Footer />
</BaseLayout>
